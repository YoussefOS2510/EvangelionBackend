    },
    {
      "name": "7. AI Question Generation",
      "item": [
        {
          "name": "Generate Bilingual AI Comprehension Question",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-User-Role", "value": "admin_servant", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_number\": 43,\n  \"start_chapter\": 3,\n  \"start_verse\": 1,\n  \"end_chapter\": 3,\n  \"end_verse\": 5,\n  \"target_group_ids\": [3],\n  \"type\": \"mcq\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/generate-questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "generate-questions"]
            },
            "description": "Triggers Google Gemini to synthesize age-tailored bilingual multiple choice questions with vocabulary from Van Dyck Arabic and NKJV English."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Bilingual prompts returned\", function () {",
                  "    pm.expect(json.question.prompt_ar).to.exist;",
                  "    pm.expect(json.question.prompt_en).to.exist;",
                  "    pm.expect(json.question.correct_answer).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Admin & Servant Operations",
      "item": [
        {
          "name": "Schedule Daily Passage Across Multiple Cohorts",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-User-Role", "value": "admin_servant", "type": "text" },
              { "key": "X-User-Id", "value": "{{servantUserId}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_ids\": [1, 2, 3],\n  \"scheduled_date\": \"2026-10-15\",\n  \"book_number\": 43,\n  \"start_chapter\": 3,\n  \"start_verse\": 1,\n  \"end_chapter\": 3,\n  \"end_verse\": 7,\n  \"excluded_verses\": [],\n  \"generate_ai_questions\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/readings/schedule",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "readings", "schedule"]
            },
            "description": "Atomically provisions or updates daily readings across selected cohorts with optional automatic AI question generation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Reading IDs created\", function () {",
                  "    pm.expect(Array.isArray(json.reading_ids)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Commit & Approve Questions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-User-Role", "value": "admin_servant", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reading_id\": \"{{readingId}}\",\n  \"questions\": [\n    {\n      \"type\": \"mcq\",\n      \"prompt_ar\": \"مَا اسْمُ الرَّجُلِ الْفَرِّيسِيِّ الَّذِي جَاءَ إِلَى يَسُوعَ لَيْلاً؟\",\n      \"prompt_en\": \"What was the name of the Pharisee who came to Jesus by night?\",\n      \"options\": {\n        \"A\": { \"ar\": \"نِيقُودِيمُوسُ\", \"en\": \"Nicodemus\" },\n        \"B\": { \"ar\": \"بُولُسُ\", \"en\": \"Paul\" },\n        \"C\": { \"ar\": \"بُطْرُسُ\", \"en\": \"Peter\" },\n        \"D\": { \"ar\": \"لِعَازَرُ\", \"en\": \"Lazarus\" }\n      },\n      \"correct_answer\": \"A\",\n      \"points_value\": 10,\n      \"sort_order\": 1,\n      \"is_approved\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/questions/commit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "questions", "commit"]
            },
            "description": "Replaces or commits finalized approved questions to a daily reading in the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
